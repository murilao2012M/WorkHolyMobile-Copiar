
name: workholy_mobile
description: "A new Flutter project."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.13.5

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8
  shared_preferences: ^2.5.6
  geolocator: ^14.1.2
  latlong2: ^0.10.1
  flutter_map: ^8.3.2
  sqflite: ^2.4.4+2
  flutter_foreground_task: ^11.0.3
  path: ^1.9.1
  firebase_core: ^5.0.0
  firebase_auth: ^7.0.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0
  flutter_launcher_icons: ^0.14.4
  sqflite_common_ffi: ^2.3.6

flutter:
  uses-material-design: true

  assets:
    - assets/exercicios/free_exercise_db.json
    - assets/exercicios/imagens/
    - assets/exercicios/traducoes_pt_BR.json
  # To add assets to your application, add an assets section, like this:
  # assets:
  #   - images/a_dot_burr.jpeg
  #   - images/a_dot_ham.jpeg

  # An asset can refer to a directory or a file.
  # See https://flutter.dev/to/asset-from-package

  # To add custom fonts to your application, add a fonts section here.
  # Each entry should have a family name and a list of fonts.
  # Example:
  # fonts:
  #   - family: Schyler
  #     fonts:
  #       - asset: fonts/Schyler-Regular.ttf
  #       - asset: fonts/Schyler-Italic.ttf
  #         style: italic

flutter_launcher_icons:
  android: true
  ios: false
  image_path: "assets/icons/logo.png"
  adaptive_icon_background: "#101010"
  adaptive_icon_foreground: "assets/icons/logo.png"

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false; // exclusão passa por função autenticada/auditada
    }

    // Backup pessoal: perfil, treinos, avaliações e corridas. Cada usuário só
    // pode acessar documentos abaixo do seu próprio UID.
    match /users/{uid}/{document=**} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // O formato versionado é separado do legado. Nenhuma versão pode ser
    // modificada ou excluída; somente o ponteiro pode mudar.
    match /workholy_backups/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['versao', 'atualizadoEm'])
        && request.resource.data.versao is string
        && exists(/databases/$(database)/documents/workholy_backups/$(uid)/versoes/$(request.resource.data.versao));
      allow delete: if false;

      match /versoes/{versao} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;

        match /partes/{parte} {
          allow read, create: if isOwner(uid);
          allow update, delete: if false;
        }
      }
    }

    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // somente Cloud Functions/Admin SDK
    }

    match /purchases/{purchaseTokenHash} {
      allow read, write: if false;
    }

    match /billing_events/{eventId} {
      allow read, write: if false;
    }

    match /health_data/{uid}/{document=**} {
      allow read, create, update, delete: if isOwner(uid);
    }
  }
}
